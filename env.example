# --- Discord ---
DISCORD_WEBHOOK_URL=isi_url_webhook_discord_kamu

# --- Trello ---
TRELLO_API_KEY=
TRELLO_TOKEN=
TRELLO_BOARD_ID=
# Opsional: kalau mau fokus ke satu list aja (misal "To Do")
TRELLO_LIST_ID=list_id

# OPTIONAL: Map board IDs ke target masing-masing divisi (string JSON). Dipakai bareng
# oleh: laporan pagi (index.js), notifikasi review (checklist-review.js), DAN Cloudflare
# Worker (buat nentuin mau diteruskan ke mana). Contoh 2 divisi:
# {
#   "ndAFQbvM": {
#     "type": "github",
#     "url": "https://discord.com/api/webhooks/xxx-programming",
#     "persona": "Nerd yang gemar bercanda pakai istilah programming (bug, commit, deploy), to the point, sedikit sarkas tapi tetap suportif."
#   },
#   "abCdEfGh": {
#     "type": "github",
#     "url": "https://discord.com/api/webhooks/xxx-art",
#     "persona": "Ekspresif dan artistik, suka pakai analogi warna/visual, hangat, banyak emoji seni."
#   }
# }
#
# PENTING soal field "type":
# - "url" dan "persona" dipakai oleh laporan pagi & notifikasi review (nentuin webhook
#   Discord tujuan + kepribadian Gemini per board).
# - "type" CUMA dipakai oleh Cloudflare Worker buat nentuin cara meneruskan event kartu:
#     - "github"  -> diteruskan ke GitHub Actions (checklist-review.js) -> Gemini -> Discord.
#                    INI YANG HARUS DIPAKAI kalau kamu mau notifikasi review jalan normal.
#     - "webhook" -> Worker langsung forward payload MENTAH Trello ke "url" tanpa lewat
#                    GitHub/Gemini sama sekali (skip pengecekan checklist). JANGAN pakai ini
#                    kecuali kamu memang mau bikin integrasi custom sendiri di luar sistem ini.
#
# Field "listId" opsional per board kalau laporan pagi mau fokus ke 1 list aja.
BOARD_TARGETS=

# --- Gemini (opsional, buat pesan semangat pagi) ---
# Kalau dikosongin, akan fallback ke pesan statis
GEMINI_API_KEY=isi_api_key_gemini
# Bahasa pesan Gemini: "id" (default) atau "en"
REMINDER_LANG=id

# --- Jadwal (format cron, default jam 7 pagi tiap hari) ---
CRON_SCHEDULE=0 7 * * *
CRON_TIMEZONE=Asia/Makassar

# --- Cloudflare worker / webhook fallback ---
TARGET_LIST_NAME=👀 In Review / Testing
# Untuk fallback GitHub dispatch (jika BOARD_TARGETS tidak dipakai)
GITHUB_OWNER=
GITHUB_REPO=
GITHUB_TOKEN=
