# --- Discord ---
DISCORD_WEBHOOK_URL=isi_url_webhook_discord_kamu

# --- Trello ---
TRELLO_API_KEY=
TRELLO_TOKEN=
TRELLO_BOARD_ID=
# Opsional: kalau mau fokus ke satu list aja (misal "To Do")
TRELLO_LIST_ID=list_id

# OPTIONAL: Map board IDs to targets (string JSON). Contoh:
# {
#   "<boardIdA>": { "type": "github" },
#   "<boardIdB>": { "type": "webhook", "url": "https://example.com/your-hook" }
# }
# Jika BOARD_TARGETS diset, worker akan memeriksa mapping ini untuk menentukan
# kemana meneruskan event (github dispatch atau forward ke webhook). Kalau tidak
# diset, worker tetap fallback ke TARGET_LIST_NAME + GITHUB_* seperti sebelumnya.
BOARD_TARGETS=

# --- Gemini (opsional, buat pesan semangat pagi) ---
# Kalau dikosongin, akan fallback ke pesan statis
GEMINI_API_KEY=isi_api_key_gemini
# Bahasa pesan Gemini: "id" (default) atau "en"
REMINDER_LANG=id

# --- Jadwal (format cron, default jam 7 pagi tiap hari) ---
CRON_SCHEDULE=0 7 * * *
CRON_TIMEZONE=Asia/Makassar

# --- Cloudflare worker / webhook fallback ---
TARGET_LIST_NAME=👀 In Review / Testing
# Untuk fallback GitHub dispatch (jika BOARD_TARGETS tidak dipakai)
GITHUB_OWNER=
GITHUB_REPO=
GITHUB_TOKEN=
